# Use the decoded key; percent-encoded keys are also accepted.
MOLIT_SERVICE_KEY=
# When blank, read 일반인증키.txt and 엔드포인트.txt from the project root.
MOLIT_ENDPOINT=
KAKAO_REST_API_KEY=
# Optional licensed provider: HTTPS endpoint returning the standard JSON array.
LISTINGS_FEED_URL=
LISTINGS_FEED_TOKEN=
# Relative paths are resolved from the project root.
REAL_ESTATE_DATA_DIR=data
# Optional flag for deployment messaging. Community Cloud may set its own platform marker.
IS_STREAMLIT_CLOUD=
